# Скопируй этот файл в .env и впиши свои значения:  cp .env.example .env

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=1234567890:AAAA-your-token-here

# ID служебного канала, куда бот складывает видео ради file_id (обязательно).
# Бот должен быть админом канала. ID вида -100..., узнать можно через @getidsbot
CACHE_CHAT_ID=-1001234567890

# ---- Необязательные настройки ----

# Прокси для скачивания (http или socks5). Нужен, если бот запущен в России:
# TikTok не отдаёт российским IP видео зарубежных авторов.
# PROXY=socks5://user:password@host:1080

# cookies.txt в формате Netscape — если TikTok начнёт блокировать yt-dlp
# COOKIES_FILE=cookies.txt

# Путь к базе кэша
# DB_PATH=cache.sqlite3

# Сколько видео качать одновременно
# MAX_PARALLEL=3
